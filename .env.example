# MediKiosk Environment Variables Template
# Copy this file to .env and fill in your private credentials.
# NEVER commit the actual .env file to version control.

# OpenAI API (For fast clinical extraction via gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Internal Kiosk Authentication
JWT_SECRET_KEY=generate_a_random_32_byte_secret_for_production
KIOSK_SHARED_SECRET=kiosk_hospital_aiia_secret_2026

# ABDM Sandbox Credentials
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medikiosk_db

# Clinical Safety Knowledge Bases
DRUG_INTERACTION_SOURCE=custom_csv    # rxnav, openfda, or custom_csv
DRUG_INTERACTION_DATA_PATH=backend/data/drug_interactions.csv
AYUSH_SAFETY_DATA_PATH=backend/data/ayush_safety.json

# DPDP Act 2023 Media Retention & Archival
DOCUMENT_RETENTION_MODE=archive_local # delete, archive_local, or archive_s3
ARCHIVE_LOCAL_PATH=/tmp/medikiosk_archive
S3_BUCKET_NAME=medikiosk-records
AWS_REGION=ap-south-1
RAW_MEDIA_RETENTION_HOURS=24
RETENTION_SWEEP_INTERVAL_MINUTES=60
